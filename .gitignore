# Cursor / Claude / Codex local IDE state — never commit.
# `.cursor/` in particular may contain internal NVIDIA skill files copied in
# from corp tooling; keep them out of the public history.
.cursor/
.claude/local/
.codex/
.guardrails/

# OS metadata
.DS_Store
Thumbs.db

# Editor scratch
*.swp
*.swo
.vscode/
.idea/

# Pre-commit local cache
.pre-commit-cache/

# TruffleHog hook-package build artifacts. The executable is downloaded only
# into a pre-commit environment and must never be committed.
/hooks/trufflehog/build/
/hooks/trufflehog/dist/
/hooks/trufflehog/*.egg-info/
/hooks/trufflehog/tests/__pycache__/
/nvidia_security_workflows_pre_commit_bridge.egg-info/
